+/// Persist what `SetState` and the lighting keys change on the lights as a
+/// whole: the output mode (on or off), the brightness and the background.
+#[cfg(feature = "storage")]
+async fn persist_output(state: &StandardState) {
+    use crate::storage::{FlashOperationMessage, LightingOutputStateRecord, send_unchecked};
+
+    send_unchecked(FlashOperationMessage::LightingOutputMode(output_mode_to_wire(
+        state.output_mode,
+    )))
+    .await;
+    send_unchecked(FlashOperationMessage::LightingOutputState(
+        LightingOutputStateRecord::new(state.output_brightness, state.background),
+    ))
+    .await;
+}
