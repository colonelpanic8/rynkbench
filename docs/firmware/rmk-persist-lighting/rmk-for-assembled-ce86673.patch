+    // A board comes up as bright as it was left, and effects turned off come
+    // back at the brightness they had (the extension record holds 0 meanwhile).
+    #[cfg(all(feature = "lighting", feature = "rynk"))]
+    #[test]
+    fn output_state_and_effects_on_value_survive_storage_reopen() {
+        block_on(async {
+            let mut storage = new_storage(async_flash_wrapper(Part::new())).await;
+            assert_eq!(storage.read_lighting_output_state().await, None);
+            assert_eq!(storage.read_lighting_effects_on_value().await, None);
+            let background = crate::lighting::BackgroundState {
+                enabled: true,
+                hue: 9,
+                saturation: 200,
+                value: 150,
+                speed: 4,
+                mode: crate::lighting::BackgroundMode::Breathe,
+            };
+            let record = LightingOutputStateRecord::new(77, background);
+            storage.put(StorageItem::LightingOutputState(record)).await.unwrap();
+            storage.put(StorageItem::LightingEffectsOnValue(90)).await.unwrap();
+            let (flash, _) = storage.flash.destroy();
+            let mut reopened = new_storage(flash).await;
+            let restored = reopened.read_lighting_output_state().await.expect("stored");
+            assert_eq!(restored.output_brightness, 77);
+            assert_eq!(restored.background(), background);
+            assert_eq!(reopened.read_lighting_effects_on_value().await, Some(90));
+        });
+    }
