+/// The lights as a whole, as a host or a lighting key last left them: the
+/// output brightness and the background. Without it a board boots at its
+/// compiled brightness and background whatever was chosen before.
+#[cfg(all(feature = "lighting", feature = "rynk"))]
+#[derive(Clone, Copy, Debug, PartialEq, Eq, serde::Serialize, serde::Deserialize)]
+#[cfg_attr(feature = "defmt", derive(defmt::Format))]
+pub struct LightingOutputStateRecord {
+    pub output_brightness: u8,
+    pub background_enabled: bool,
+    pub background_breathe: bool,
+    pub hue: u8,
+    pub saturation: u8,
+    pub value: u8,
+    pub speed: u8,
+}
+
+#[cfg(all(feature = "lighting", feature = "rynk"))]
+impl LightingOutputStateRecord {
+    pub fn new(output_brightness: u8, background: crate::lighting::BackgroundState) -> Self {
+        Self {
+            output_brightness,
+            background_enabled: background.enabled,
+            background_breathe: matches!(background.mode, crate::lighting::BackgroundMode::Breathe),
+            hue: background.hue,
+            saturation: background.saturation,
+            value: background.value,
+            speed: background.speed,
+        }
+    }
+
+    /// The stored background, to start the engine with.
+    pub fn background(&self) -> crate::lighting::BackgroundState {
+        crate::lighting::BackgroundState {
+            enabled: self.background_enabled,
+            hue: self.hue,
+            saturation: self.saturation,
+            value: self.value,
+            speed: self.speed,
+            mode: if self.background_breathe {
+                crate::lighting::BackgroundMode::Breathe
+            } else {
+                crate::lighting::BackgroundMode::Solid
+            },
+        }
+    }
+}
