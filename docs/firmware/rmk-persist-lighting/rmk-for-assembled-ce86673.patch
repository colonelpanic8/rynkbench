+    /// The lights as a whole and the effects' brightness survive a restart:
+    /// `SetState` stores on or off, brightness and background, and turning
+    /// effects off keeps the brightness they had.
+    #[cfg(feature = "storage")]
+    #[test]
+    fn output_state_and_effects_brightness_persist() {
+        use crate::storage::FlashOperationMessage;
+        use rmk_types::protocol::rynk::{LightingBackgroundMode, LightingBackgroundState, LightingMutableState};
+        while crate::storage::try_receive_flash_message().is_some() {}
+        // The flash queue is small and nothing drains it here: take what each
+        // request queued before sending the next.
+        let mut queued = std::vec::Vec::new();
+        let drain = |queued: &mut std::vec::Vec<FlashOperationMessage>| {
+            while let Some(message) = crate::storage::try_receive_flash_message() {
+                queued.push(message);
+            }
+        };
+        run_extension_flow(
+            TestExtensionSource {
+                state: crate::lighting::compositor::ExtensionState {
+                    effect: 1,
+                    palette: 0,
+                    value: 128,
+                    speed: 20,
+                },
+                params: [3, 128],
+            },
+            async |protocol| {
+                let mut revision = 0;
+                for value in [90, 0] {
+                    let state = WireExtensionState {
+                        effect: 1,
+                        palette: 0,
+                        value,
+                        speed: 20,
+                    };
+                    revision = match protocol
+                        .request(RynkLightingCommand::SetExtensionState {
+                            expected_revision: revision,
+                            state,
+                        })
+                        .await
+                    {
+                        Ok(RynkLightingReadback::State(state)) => state.revision,
+                        other => panic!("extension write failed: {other:?}"),
+                    };
+                    drain(&mut queued);
+                }
+                let wanted = LightingMutableState {
+                    output_enabled: false,
+                    output_brightness: 77,
+                    background: LightingBackgroundState {
+                        enabled: true,
+                        hue: 9,
+                        saturation: 200,
+                        value: 150,
+                        speed: 4,
+                        mode: LightingBackgroundMode::Breathe,
+                    },
+                };
+                assert!(matches!(
+                    protocol
+                        .request(RynkLightingCommand::SetState {
+                            expected_revision: revision,
+                            state: wanted,
+                        })
+                        .await,
+                    Ok(RynkLightingReadback::State(_))
+                ));
+                drain(&mut queued);
+            },
+        );
+        let (mut on_value, mut output, mut mode) = (None, None, None);
+        for message in queued {
+            match message {
+                FlashOperationMessage::LightingEffectsOnValue(value) => on_value = Some(value),
+                FlashOperationMessage::LightingOutputState(record) => output = Some(record),
+                FlashOperationMessage::LightingOutputMode(value) => mode = Some(value),
+                _ => {}
+            }
+        }
+        assert_eq!(on_value, Some(90), "turning effects off must keep their brightness");
+        let output = output.expect("SetState must reach storage");
+        assert_eq!(output.output_brightness, 77);
+        assert_eq!(
+            output.background(),
+            crate::lighting::BackgroundState {
+                enabled: true,
+                hue: 9,
+                saturation: 200,
+                value: 150,
+                speed: 4,
+                mode: crate::lighting::BackgroundMode::Breathe,
+            }
+        );
+        assert_eq!(mode, Some(WireLightingOutputMode::AlwaysOff));
+    }
+
