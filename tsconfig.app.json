{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    // `node` is here for the tests under src/, which read the vendored wasm
    // off disk: a `--target web` package initializes from a fetch the Node
    // test runner cannot serve.
    "types": ["vite/client", "node"],
    "allowArbitraryExtensions": true,
    // The flake records each vendored wasm package's source pin as JSON beside
    // it; `src/session/build-identity.ts` imports those directly.
    "resolveJsonModule": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
